# ============================================================
# 环境变量模板：复制为 .env 后填入真实值
#   copy .env.example .env
# 必填项缺失时，对应模块会抛出明确错误（含键名）；其余项有代码内默认值。
# ============================================================

# ---------- LLM（兼容 OpenAI 协议的任意服务）----------
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen-flash
ITEM_MODEL=qwen-flash
VL_MODEL=qwen3.7-flash
KG_MODEL=qwen-flash
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1

# ---------- 嵌入 / 重排模型（本地目录）----------
BGE_M3_PATH=/path/to/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=/path/to/bge-reranker
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0
EMBEDDING_DIM=1024

# ---------- Milvus ----------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=bio_chunks_v1
ITEM_NAME_COLLECTION=bio_subject_names_v1
ENTITY_NAME_COLLECTION=bio_entity_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ---------- Neo4j ----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---------- MongoDB ----------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=bio_kb

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=bio-knowledge-base

# ---------- MinerU（仅解析 PDF 时需要）----------
MINERU_MODEL_SOURCE=modelscope
MINERU_MODEL_BASE_DIR=
MINERU_TIER=standard
PDF_IMAGES_MODE=extract
PDF_PARSE_TIMEOUT=3600
IMG_SUMMARY_MAX_WORKERS=4

# ---------- 查询链路参数 ----------
MAX_CONTEXT_CHARS=12000
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.5
RRF_K=60
RRF_KG_WEIGHT=0.7
RRF_MAX_RESULTS=10
EMBEDDING_SEARCH_LIMIT=10
HYDE_SEARCH_LIMIT=5
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.6
ITEM_NAME_MAX_OPTIONS=5

# ---------- 联网检索（可选，留空则关闭）----------
MCP_DASHSCOPE_BASE_URL=

# ---------- 服务自身 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
# 留空=不鉴权，仅限本机开发；上线务必设置
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
IMPORT_DROP_COLLECTION=false